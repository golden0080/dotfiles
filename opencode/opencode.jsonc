{
    "$schema": "https://opencode.ai/config.json",
    "provider": {
        "hazel-local": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "Hazel Local LLM",
            "options": {
                "baseURL": "http://192.168.1.188:8081/v1"
            },
            "models": {
                "qwen3.6-35B": {
                    "name": "Qwen Series Models",
                    "limit": {
                        "context": 266140,
                        "output": 102400
                    }
                }
            }
        }
    },
    "permission": {
        "question": "allow",
        "websearch": "allow"
    }
}
